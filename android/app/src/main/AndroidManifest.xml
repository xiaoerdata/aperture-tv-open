<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <queries><package android:name="com.mitv.tvhome"/><package android:name="com.xiaomi.mitv.tvhome"/><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent><intent><action android:name="android.intent.action.ASSIST"/></intent><intent><action android:name="android.intent.action.VOICE_COMMAND"/></intent><intent><action android:name="android.settings.VOICE_INPUT_SETTINGS"/></intent><intent><action android:name="android.settings.SETTINGS"/></intent><intent><action android:name="android.settings.SYNC_SETTINGS"/></intent><intent><action android:name="android.intent.action.VIEW"/><data android:mimeType="application/vnd.android.package-archive" android:scheme="content"/></intent><intent><action android:name="android.intent.action.UNINSTALL_PACKAGE"/><data android:scheme="package"/></intent></queries>
    <!-- Native cinema accepts HTTP only after explicit per-import approval; private household/NAS flows retain their own TLS policy. -->
    <application android:label="${appLabel}" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/kaishi_icon_v2" android:banner="@drawable/kaishi_banner_v2" android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name=".ResourcePackAgentActivity" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true"/>
        <activity android:name=".CinemaActivity" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true"/>
        <provider android:name=".InstallFileProvider" android:authorities="${applicationId}.install" android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".AppAgentActivity" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true"/>
        <activity android:name=".NasActivity" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true"/>
        <activity android:name=".NasSetupActivity" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true"/>
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
        </activity>
        <!-- Ordinary app until the user explicitly enables this edition's HOME entry. -->
        <activity-alias android:name=".HomeEntry" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity-alias>
    </application>
</manifest>
