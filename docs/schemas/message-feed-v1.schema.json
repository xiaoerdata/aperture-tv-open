{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "开视留言源 v1",
  "type": "object",
  "required": ["version", "messages"],
  "properties": {
    "version": {"const": 1},
    "timezone": {"type": "string", "default": "Asia/Shanghai", "description": "IANA时区，运行时再次校验"},
    "messages": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "time": {"type": "string", "pattern": "^(|(?:[01][0-9]|2[0-3]):[0-5][0-9](?:-(?:[01][0-9]|2[0-3]):[0-5][0-9])?)$"},
          "repeat": {"enum": ["daily", "once"], "default": "once"},
          "date": {"type": "string", "description": "once且有time时必须为有效YYYY-MM-DD"},
          "tts": {"type": "boolean", "default": false},
          "expireAt": {"type": "string", "description": "非空时必须为含秒和UTC偏移的ISO8601"}
        }
      }
    }
  },
  "description": "全文件128KiB上限；ID唯一、有效日期、时间范围和时区用生产解析器二次校验。未知字段忽略，不展示署名。"
}
